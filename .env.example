# EXAMPLE CONFIGURATION. This file contains no real passwords.
# To get started, run: bash env_setup.sh
# The script creates .env and replaces __GENERATE_*__ with random passwords.
# Then open .env and fill in ICECAT_USER and ICECAT_PASS.
# Do not use this template as .env without generating the passwords first.

# 1. FILL THESE IN: your Icecat account credentials.
# Single quotes preserve $ in passwords without variable interpolation.
# Escape any single quote within the password with a backslash: \'
ICECAT_USER='YOUR_ICECAT_LOGIN'
ICECAT_PASS='YOUR_ICECAT_PASSWORD'

# 2. DEFAULTS: Icecat data source settings usually need no changes.
# If your subscription uses a different export directory, set it here.
# ICECAT_BASE and ICECAT_REPO must end with /.
ICECAT_BASE='https://data.icecat.biz/export/'
ICECAT_REPO='freexml/'
LANG_LIST='refs/LanguageList.xml.gz'
SUPPLIERS_LIST='refs/SuppliersList.xml.gz'
SUPPLIER_MAPPING='EN/supplier_mapping.xml'

# 3. DATABASE: env_setup.sh generates these passwords automatically.
# After the first deployment, changing passwords only in .env will not
# update the corresponding user passwords in the existing database.
DB_USER='db_user'
DB_PASS='__GENERATE_DB_PASSWORD__'
DB_SCHEMA='db_name'
FLYWAY_USER='flyway'
FLYWAY_PASSWORD='__GENERATE_FLYWAY_PASSWORD__'
MYSQL_ROOT_PASSWORD='__GENERATE_ROOT_PASSWORD__'

# 4. INTERNAL COMPOSE NETWORK: leave these values unchanged.
# These are service names, not the VM IP address or localhost.
# Compose also sets these addresses explicitly for the Java container.
DB_HOST='database'
DB_PORT='3306'
DB_PARAMS='serverTimezone=UTC&useUnicode=true&characterEncoding=UTF-8'
JAVA_HOST='http://java'
JAVA_PORT='8086'
